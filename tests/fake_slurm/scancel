"""Test double for ``scancel``."""

import os
import sys
from pathlib import Path

STATE_DIR = Path(os.environ.get("FAKE_SLURM_STATE", "/tmp/fake-slurm"))
_DEFAULT_SIGNAL = "USR2"


def main(argv: list[str]) -> int:
    """Record the cancel in the job's state file and return the exit code."""
    signal = _DEFAULT_SIGNAL
    job_id = None
    for arg in argv:
        if arg.startswith("--signal="):
            signal = arg.split("=", 1)[1]
        elif arg.isdigit():
            job_id = arg
    if job_id is None:
        print("scancel: error: no job id", file=sys.stderr)
        return 1
    state_file = STATE_DIR / f"{job_id}.state"
    if state_file.exists():
        state = "CANCELLED" if signal == "KILL" else "RUNNING"
        state_file.write_text(f"{state}\n0\n", encoding="utf-8")
    print(f"scancel: sent {signal} to job {job_id}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
