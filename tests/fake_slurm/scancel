#!/usr/bin/env python3
"""Test double for ``scancel``."""

import os
import sys

STATE_DIR = os.environ.get("FAKE_SLURM_STATE", "/tmp/fake-slurm")


def main(argv: list[str]) -> int:
    signal = "USR2"
    job_id = None
    for arg in argv:
        if arg.startswith("--signal="):
            signal = arg.split("=", 1)[1]
        elif arg.isdigit():
            job_id = arg
    if job_id is None:
        print("scancel: error: no job id", file=sys.stderr)
        return 1
    state_file = os.path.join(STATE_DIR, f"{job_id}.state")
    if os.path.exists(state_file):
        with open(state_file, "w") as handle:
            handle.write(("CANCELLED\n" if signal == "KILL" else "RUNNING\n") + "0\n")
    print(f"scancel: sent {signal} to job {job_id}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
