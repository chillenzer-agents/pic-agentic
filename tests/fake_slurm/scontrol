r"""Test double for ``scontrol show job <id>``.

The state file under ``FAKE_SLURM_STATE`` holds one or more *entries*, each one
``STATE`` optionally followed by an integer exit code.  The original single
entry (``COMPLETED 0`` or ``COMPLETED\n0``, as ``sbatch`` writes it) keeps being
reported forever.  A file with several entries is a *sequence*: each invocation
pops the first entry and writes the remainder back, so successive calls walk
``PENDING`` -> ``RUNNING`` -> ``COMPLETED 0``.

Only ``show job`` is supported: the M3 control delivery paths go through
``scancel`` (``scontrol`` has no ``signal``/``cancel`` subcommand in real Slurm,
as the live cluster confirmed).
"""

import os
import sys
from pathlib import Path

STATE_DIR = Path(os.environ.get("FAKE_SLURM_STATE", "/tmp/fake-slurm"))


def parse_entries(lines: list[str]) -> list[tuple[str, int, str | None]]:
    """Group the file's non-empty lines into ``(state, exit_code, reason)``.

    A line that is a bare integer belongs to the preceding state line as its
    exit code; any other line starts a new entry.  An entry may carry an
    optional third token: the SLURM ``Reason=`` string (e.g.
    ``PENDING 0 PartitionNodeLimit``), which ``scontrol`` reports verbatim.

    Args:
        lines: The non-empty lines of the state file.

    Returns:
        The parsed entries, in file order.

    """
    entries: list[tuple[str, int, str | None]] = []
    for line in lines:
        token = line.split()
        if not token:
            continue
        if len(token) == 1 and token[0].lstrip("-").isdigit() and entries:
            state, _, reason = entries[-1]
            entries[-1] = (state, int(token[0]), reason)
            continue
        exit_code = int(token[1]) if len(token) > 1 else 0
        reason = token[2] if len(token) > 2 else None
        entries.append((token[0], exit_code, reason))
    return entries


def main(argv: list[str]) -> int:
    """Print the fake ``scontrol`` report and return the exit code."""
    if len(argv) < 3 or argv[0] != "show" or argv[1] != "job":
        print("scontrol: error: unsupported invocation", file=sys.stderr)
        return 1
    job_id = argv[2]
    state_file = STATE_DIR / f"{job_id}.state"
    if not state_file.exists():
        print(f"scontrol: error: Job {job_id} not found", file=sys.stderr)
        return 1
    lines = [line for line in state_file.read_text(encoding="utf-8").splitlines() if line.strip()]
    entries = parse_entries(lines)
    if not entries:
        entries = [("UNKNOWN", 0, None)]
    state, exit_code, reason = entries[0]
    if len(entries) > 1:

        def _fmt(entry: tuple[str, int, str | None]) -> str:
            name, code, entry_reason = entry
            fields = [name]
            if code or entry_reason is not None:
                fields.append(str(code))
            if entry_reason is not None:
                fields.append(entry_reason)
            return " ".join(fields)

        state_file.write_text("\n".join(_fmt(entry) for entry in entries[1:]) + "\n", encoding="utf-8")
    # Mirror real `scontrol show job` layout: one attribute per line,
    # indented, JobId on the first line by itself.
    print(f"JobId={job_id} JobName=wrap")
    print(f"   JobState={state} Reason={reason or 'None'}")
    print(f"   ExitCode={exit_code}:0 RunTime=00:00:01 TimeLimit=01:00:00")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
