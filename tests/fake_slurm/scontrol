"""Test double for ``scontrol show job <id>``."""

import os
import sys
from pathlib import Path

STATE_DIR = Path(os.environ.get("FAKE_SLURM_STATE", "/tmp/fake-slurm"))


def main(argv: list[str]) -> int:
    """Print the fake ``scontrol`` report and return the exit code."""
    if len(argv) < 3 or argv[0] != "show" or argv[1] != "job":
        print("scontrol: error: unsupported invocation", file=sys.stderr)
        return 1
    job_id = argv[2]
    state_file = STATE_DIR / f"{job_id}.state"
    if not state_file.exists():
        print(f"scontrol: error: Job {job_id} not found", file=sys.stderr)
        return 1
    lines = state_file.read_text(encoding="utf-8").split()
    state = lines[0] if lines else "UNKNOWN"
    exit_code = int(lines[1]) if len(lines) > 1 else 0
    # Mirror real `scontrol show job` layout: one attribute per line,
    # indented, JobId on the first line by itself.
    print(f"JobId={job_id} JobName=wrap")
    print(f"   JobState={state} Reason=None")
    print(f"   ExitCode={exit_code}:0 RunTime=00:00:01 TimeLimit=01:00:00")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
