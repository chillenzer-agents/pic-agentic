r"""Test double for ``scontrol show job <id>`` / ``signal`` / ``cancel``.

The state file under ``FAKE_SLURM_STATE`` holds one or more *entries*, each one
``STATE`` optionally followed by an integer exit code.  The original single
entry (``COMPLETED 0`` or ``COMPLETED\n0``, as ``sbatch`` writes it) keeps being
reported forever.  A file with several entries is a *sequence*: each invocation
pops the first entry and writes the remainder back, so successive calls walk
``PENDING`` -> ``RUNNING`` -> ``COMPLETED 0``.

``signal <SIG> <jobid>`` appends the signal to ``<jobid>.signals`` and
``cancel <jobid>`` rewrites ``<jobid>.state`` to ``CANCELLED``; both are the M3
control delivery paths.
"""

import os
import sys
from pathlib import Path

STATE_DIR = Path(os.environ.get("FAKE_SLURM_STATE", "/tmp/fake-slurm"))


def parse_entries(lines: list[str]) -> list[tuple[str, int]]:
    """Group the file's non-empty lines into ``(state, exit_code)`` entries.

    A line that is a bare integer belongs to the preceding state line as its
    exit code; any other line starts a new entry.

    Args:
        lines: The non-empty lines of the state file.

    Returns:
        The parsed entries, in file order.

    """
    entries: list[tuple[str, int]] = []
    for line in lines:
        token = line.split()
        if not token:
            continue
        if len(token) == 1 and token[0].lstrip("-").isdigit() and entries:
            state, _ = entries[-1]
            entries[-1] = (state, int(token[0]))
            continue
        entries.append((token[0], int(token[1]) if len(token) > 1 else 0))
    return entries


def main(argv: list[str]) -> int:
    """Print the fake ``scontrol`` report and return the exit code."""
    if len(argv) >= 3 and argv[0] == "signal":
        return _signal(argv[1], argv[2])
    if len(argv) >= 2 and argv[0] == "cancel":
        return _cancel(argv[1])
    if len(argv) < 3 or argv[0] != "show" or argv[1] != "job":
        print("scontrol: error: unsupported invocation", file=sys.stderr)
        return 1
    job_id = argv[2]
    state_file = STATE_DIR / f"{job_id}.state"
    if not state_file.exists():
        print(f"scontrol: error: Job {job_id} not found", file=sys.stderr)
        return 1
    lines = [line for line in state_file.read_text(encoding="utf-8").splitlines() if line.strip()]
    entries = parse_entries(lines)
    if not entries:
        entries = [("UNKNOWN", 0)]
    state, exit_code = entries[0]
    if len(entries) > 1:
        remainder = "\n".join(f"{name} {code}" if code else name for name, code in entries[1:])
        state_file.write_text(remainder + "\n", encoding="utf-8")
    # Mirror real `scontrol show job` layout: one attribute per line,
    # indented, JobId on the first line by itself.
    print(f"JobId={job_id} JobName=wrap")
    print(f"   JobState={state} Reason=None")
    print(f"   ExitCode={exit_code}:0 RunTime=00:00:01 TimeLimit=01:00:00")
    return 0


def _signal(signal: str, job_id: str) -> int:
    """Record a delivered signal for the M3 control path.

    Returns:
        The exit code (1 when the job is unknown).

    """
    if not (STATE_DIR / f"{job_id}.state").exists():
        print(f"scontrol: error: Job {job_id} not found", file=sys.stderr)
        return 1
    with (STATE_DIR / f"{job_id}.signals").open("a", encoding="utf-8") as handle:
        handle.write(f"{signal}\n")
    print(f"Signal {signal} sent to JobId={job_id}")
    return 0


def _cancel(job_id: str) -> int:
    """Rewrite a job's state to CANCELLED for the M3 hard-cancel path.

    Returns:
        The exit code (1 when the job is unknown).

    """
    state_file = STATE_DIR / f"{job_id}.state"
    if not state_file.exists():
        print(f"scontrol: error: Job {job_id} not found", file=sys.stderr)
        return 1
    state_file.write_text("CANCELLED\n", encoding="utf-8")
    print(f"cancel: JobId={job_id} cancelled")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
